{
  "info": {
    "_postman_id": "golidoli-website-login-v2",
    "name": "GoliDoli OTT - Website Login API",
    "description": "Postman Collection for GoliDoli OTT Website Login (POST /api/auth/website-login) using Mobile JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Prerequisite - Mobile Auth (Get Mobile JWT)",
      "item": [
        {
          "name": "1. Send Mobile OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919999999999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "send-otp"]
            },
            "description": "Sends an OTP to the mobile phone number."
          },
          "response": []
        },
        {
          "name": "2. Verify Mobile OTP (Saves mobileJwt)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const token = res.token || (res.data && res.data.token) || res.userToken;",
                  "if (token) {",
                  "    pm.collectionVariables.set('mobileJwt', token);",
                  "    console.log('Mobile JWT Token saved to collection variable: mobileJwt');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919999999999\",\n  \"otp\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-otp"]
            },
            "description": "Verifies OTP and extracts the mobile JWT into {{mobileJwt}}."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Website Login - Success (POST /api/auth/website-login)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response matches expected structure', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.success).to.be.true;",
              "    pm.expect(json.message).to.eql('Website login successful');",
              "    pm.expect(json.token).to.be.a('string');",
              "    pm.expect(json.user).to.be.an('object');",
              "    pm.expect(json.user.id).to.be.a('string');",
              "    pm.expect(json.user.name).to.be.a('string');",
              "    pm.expect(json.user.email).to.exist;",
              "    pm.expect(json.user.phone).to.be.a('string');",
              "    pm.expect(json.user.profileImage).to.exist;",
              "    pm.expect(json.user.role).to.be.a('string');",
              "    // Check no extra internal fields",
              "    pm.expect(json.user._id).to.be.undefined;",
              "    pm.expect(json.user.password).to.be.undefined;",
              "    pm.expect(json.user.__v).to.be.undefined;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{mobileJwt}}",
            "description": "Existing mobile app JWT passed via Bearer token"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/website-login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "website-login"]
        },
        "description": "Verifies mobile JWT, extracts user, issues website JWT, and returns only required fields."
      },
      "response": []
    },
    {
      "name": "2. Error - Missing Authorization Token (Expect 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test('Error message received', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.success).to.be.false;",
              "    pm.expect(json.message).to.eql('Authorization token is required');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/website-login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "website-login"]
        }
      },
      "response": []
    },
    {
      "name": "3. Error - Invalid Token (Expect 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test('Error message received', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.success).to.be.false;",
              "    pm.expect(json.message).to.eql('Invalid token');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer invalid.signature.token"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/website-login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "website-login"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "mobileJwt",
      "value": "",
      "type": "string"
    }
  ]
}
