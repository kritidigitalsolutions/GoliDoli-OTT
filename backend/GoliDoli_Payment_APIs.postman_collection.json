{
  "info": {
    "_postman_id": "golidoli-payment-sabpaisa-v3",
    "name": "GoliDoli OTT - Payment APIs (SabPaisa)",
    "description": "Complete collection for testing GoliDoli OTT SabPaisa Payment Gateway, Auth OTP flow, Status Enquiry, and Webhooks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Authentication (Get JWT Token)",
      "item": [
        {
          "name": "1. Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919999999999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "send-otp"]
            },
            "description": "Sends an OTP to the given phone number for sandbox/testing."
          },
          "response": []
        },
        {
          "name": "2. Verify OTP & Auto-Save Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const token = res.token || (res.data && res.data.token) || res.userToken;",
                  "if (token) {",
                  "    pm.collectionVariables.set('token', token);",
                  "    console.log('JWT Token saved to collection variable: token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919999999999\",\n  \"otp\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-otp"]
            },
            "description": "Verifies the 4-digit OTP and automatically sets the {{token}} variable."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Plans & Discounts",
      "item": [
        {
          "name": "Get All Active Plans",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.plans && res.plans.length > 0) {",
                  "    pm.collectionVariables.set('planId', res.plans[0]._id);",
                  "    console.log('Saved first planId to variable:', res.plans[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/plan",
              "host": ["{{baseUrl}}"],
              "path": ["api", "plan"]
            },
            "description": "Fetches all subscription plans from MongoDB."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Payment Operations",
      "item": [
        {
          "name": "1. Initiate Payment (Create Order)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.clientTxnId) {",
                  "    pm.collectionVariables.set('clientTxnId', res.clientTxnId);",
                  "    console.log('Saved clientTxnId:', res.clientTxnId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{planId}}\",\n  \"promoCode\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payment/initiate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment", "initiate"]
            },
            "description": "Initiates payment, creates unique clientTxnId, and prepares encrypted checkout payload for SabPaisa."
          },
          "response": []
        },
        {
          "name": "2. Check Transaction Status / Enquiry",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payment/status/{{clientTxnId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment", "status", "{{clientTxnId}}"]
            },
            "description": "Checks status in database and queries live SabPaisa enquiry if needed."
          },
          "response": []
        },
        {
          "name": "3. SabPaisa Dedicated Webhook (Simulate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-sabpaisa-signature",
                "value": "{{webhookSignature}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientTxnId\": \"{{clientTxnId}}\",\n  \"sabpaisaTxnId\": \"SP_TEST_12345\",\n  \"status\": \"SUCCESS\",\n  \"statusCode\": \"0000\",\n  \"paidAmount\": 199,\n  \"metadata\": {\n    \"planId\": \"{{planId}}\",\n    \"userId\": \"\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payment/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment", "webhook"]
            },
            "description": "Server-to-server webhook invoked by SabPaisa to idempotently activate subscriptions."
          },
          "response": []
        },
        {
          "name": "4. SabPaisa Callback Route (Classic Encrypted)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"encResponse\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payment/sabpaisa-response",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment", "sabpaisa-response"]
            },
            "description": "Preserved fallback callback endpoint."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "planId",
      "value": "6a674791c03ac60c2142cbdb",
      "type": "string"
    },
    {
      "key": "clientTxnId",
      "value": "TXN_SAMPLE_123",
      "type": "string"
    },
    {
      "key": "webhookSignature",
      "value": "",
      "type": "string"
    }
  ]
}
